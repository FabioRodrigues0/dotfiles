{
    "window.autoDetectColorScheme": false,
    "workbench.preferredDarkColorTheme": "Tokyo Night",
    "editor.fontFamily": "'JetBrains Mono', monospace",
    "editor.fontLigatures": true,
    "editor.minimap.autohide": true,
    "workbench.colorTheme": "Tokyo Night",
    "workbench.preferredHighContrastLightColorTheme": "Solarized Light",
    "workbench.preferredLightColorTheme": "Solarized Light",
    "workbench.iconTheme": "bearded-icons",
    "workbench.editor.autoLockGroups": {
        "terminalEditor": false
    },
    "workbench.editor.showTabs": "single",
    "zenMode.fullScreen": false,
    "zenMode.hideLineNumbers": false,
    "zenMode.showTabs": "single",
    "cursor.composer.editorConversationDensity": "compact-all-grouped",
    "vim.leader": "<space>",
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "<space>"
            ],
            "commands": [
                "doom.whichKeyShow"
            ]
        },
        {
            "before": [
                "<C-j>"
            ],
            "after": [
                "i",
                "<CR>",
                "<Esc>",
                "^"
            ]
        },
        {
            "before": [
                "<C-k>"
            ],
            "commands": [
                "editor.action.deleteLines"
            ]
        }
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        {
            "before": [
                "<space>"
            ],
            "commands": [
                "doom.whichKeyShow"
            ]
        }
    ],
    // Como no Doom Emacs: SPC m r corre o projeto (fish `correr`); SPC c f grava
    // (formatOnSave) e passa o Spotless no ficheiro quando o projeto Gradle o usa.
    "whichkey.bindingOverrides": [
        {
            "keys": "m",
            "name": "+localleader",
            "type": "bindings",
            "bindings": [
                {
                    "key": "r",
                    "name": "Correr projeto",
                    "type": "command",
                    "command": "workbench.action.tasks.runTask",
                    "args": "Correr projeto"
                }
            ]
        },
        {
            "keys": "c.f",
            "name": "Format buffer/region",
            "type": "conditional",
            "bindings": [
                {
                    "key": "editorHasSelection",
                    "name": "Format selection",
                    "type": "command",
                    "command": "editor.action.formatSelection"
                },
                {
                    "key": "",
                    "name": "Format document",
                    "type": "commands",
                    "commands": [
                        "workbench.action.files.save",
                        "workbench.action.tasks.runTask"
                    ],
                    "args": [
                        null,
                        "Spotless"
                    ]
                }
            ]
        }
    ],
    "window.restoreWindows": "none",
    "window.menuBarVisibility": "compact",
    "[java]": {
        "editor.defaultFormatter": "Oracle.oracle-java"
    },
    "jdk.format.options": {},
    "doom.dashboard.openOnActivation": false,
    // Python: so o pyrefly como LSP (cursorpyright desinstalado)
    "python.languageServer": "None",
    // Poupar recursos
    "editor.minimap.enabled": false,
    "telemetry.telemetryLevel": "off",
    "workbench.enableExperiments": false,
    "workbench.settings.enableNaturalLanguageSearch": false,
    "extensions.autoCheckUpdates": false,
    "extensions.autoUpdate": false,
    "search.followSymlinks": false,
    "npm.autoDetect": "off",
    "typescript.tsc.autoDetect": "off",
    "grunt.autoDetect": "off",
    "gulp.autoDetect": "off",
    "jake.autoDetect": "off",
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.venv/**": true,
        "**/venv/**": true,
        "**/__pycache__/**": true,
        "**/.mypy_cache/**": true,
        "**/.pytest_cache/**": true,
        "**/node_modules/**": true,
        "**/build/**": true,
        "**/target/**": true,
        "**/.gradle/**": true
    },
    "search.exclude": {
        "**/.venv": true,
        "**/venv": true,
        "**/__pycache__": true,
        "**/build": true,
        "**/target": true,
        "**/.gradle": true
    },
    "redhat.telemetry.enabled": true,
    "editor.fontSize": 16,
    // Tokyo Night pinta classes e metodos de azul; classes ficam na cor do
    // texto como no doom-tokyo-night do Emacs, metodos continuam azuis.
    "editor.semanticTokenColorCustomizations": {
        "[Tokyo Night]": {
            "rules": {
                "class": "#c0caf5",
                "interface": "#c0caf5",
                "enum": "#c0caf5",
                "record": "#c0caf5",
                "type": "#c0caf5",
                "typeParameter": "#c0caf5"
            }
        }
    },
    "editor.tokenColorCustomizations": {
        "[Tokyo Night]": {
            "textMateRules": [
                {
                    "scope": [
                        "entity.name.type",
                        "entity.name.type.class",
                        "entity.name.type.interface",
                        "entity.name.type.enum",
                        "support.class",
                        "storage.type.java",
                        "storage.type.generic.java",
                        "storage.type.object.array.java"
                    ],
                    "settings": { "foreground": "#c0caf5" }
                }
            ]
        }
    }
}